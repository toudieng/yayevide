# /etc/yaayvide/yaayvide.env — variables de production de Yaay Vidé
# Copier ce fichier sur le serveur, remplir les valeurs, puis :
#   sudo chown root:yaayvide /etc/yaayvide/yaayvide.env
#   sudo chmod 640 /etc/yaayvide/yaayvide.env
# Ne JAMAIS le mettre dans git.

# --- Django ---
DJANGO_DEBUG=False
# Générer avec : python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=a-remplacer
DJANGO_ALLOWED_HOSTS=yaayvide.com,www.yaayvide.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yaayvide.com,https://www.yaayvide.com
DJANGO_CORS_ALLOWED_ORIGINS=https://yaayvide.com,https://www.yaayvide.com
# /admin est le tableau de bord React : l'admin Django passe ailleurs
DJANGO_ADMIN_PATH=gestion-technique/
# Facultatif : dossiers des fichiers (par défaut backend/media et backend/media_prive)
# DJANGO_MEDIA_ROOT=/srv/yaayvide/backend/media
# DJANGO_PRIVATE_MEDIA_ROOT=/srv/yaayvide/backend/media_prive
# 0 au début ; 31536000 (1 an) quand le HTTPS fonctionne depuis quelques jours
DJANGO_HSTS_SECONDS=0

# --- Base PostgreSQL ---
DB_NAME=yaayvide
DB_USER=yaayvide
DB_PASSWORD=a-remplacer
DB_HOST=localhost
DB_PORT=5432

# --- Liens dans les e-mails ---
FRONTEND_URL=https://yaayvide.com
BACKEND_URL=https://yaayvide.com

# --- E-mails (exemple OVH ; Brevo : smtp-relay.brevo.com, port 587, TLS) ---
EMAIL_HOST=ssl0.ovh.net
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=no-reply@yaayvide.com
EMAIL_HOST_PASSWORD=a-remplacer
DEFAULT_FROM_EMAIL="Yaay Vidé <no-reply@yaayvide.com>"

# --- Divers ---
WHATSAPP_SUPPORT_NUMBER=221710189191
# Numéros marchands affichés pour payer l'e-book (facultatif : ce sont les valeurs par défaut)
EBOOK_NUMERO_WAVE=710189191
EBOOK_NUMERO_ORANGE_MONEY=710189191
EBOOK_NUMERO_MIXX=769319911
# Paiement InTouch (non utilisé pour l'e-book) : laisser vide
INTOUCH_TOKEN=
INTOUCH_DOMAIN_NAME=
INTOUCH_AGENCY_CODE=
